# Authentication
API_KEY=123
JWT_SECRET=your_jwt_secret_here_must_be_at_least_32_characters_long
SESSION_SECRET=your_session_secret_here_must_be_at_least_32_characters_long

# N8N Integration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/whatsapp

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Database
DB_PATH=./anakisa.db
DB_POOL_SIZE=5
DB_ACQUIRE_TIMEOUT=10000
DB_IDLE_TIMEOUT=300000
DB_REAP_INTERVAL=60000
DB_MAX_RETRIES=3
