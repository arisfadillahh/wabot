# Environment Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Security
API_KEY=123
JWT_SECRET=your-secret-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
FRONTEND_URL=http://localhost:3000

# Database
DB_PATH=./anakisa.db
DB_POOL_SIZE=5
DB_ACQUIRE_TIMEOUT=10000
DB_IDLE_TIMEOUT=300000
DB_REAP_INTERVAL=60000
DB_MAX_RETRIES=3

# Cache Configuration
CACHE_CHAT_TTL=30000
CACHE_USER_TTL=86400000
CACHE_ANALYTICS_TTL=300000
CACHE_MAX_SIZE=1000
CACHE_CLEANUP_INTERVAL=300000

# Session Configuration
SESSION_TTL=86400000
SESSION_MAX_SESSIONS=1000
SESSION_CLEANUP_INTERVAL=3600000
SESSION_RENEWAL_WINDOW=3600000

# WhatsApp Configuration
WHATSAPP_SESSION_TIMEOUT=300000
WHATSAPP_RECONNECT_ATTEMPTS=5
WHATSAPP_RECONNECT_DELAY=5000
WHATSAPP_MESSAGE_RETRY_ATTEMPTS=3

# WebSocket Configuration
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=60000
WS_MAX_CONNECTIONS=1000
WS_MESSAGE_QUEUE_SIZE=1000
WS_BROADCAST_RATE_LIMIT=100

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESS=false
RATE_LIMIT_SKIP_FAILED=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=server.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# Webhook Configuration
N8N_WEBHOOK_URL=
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_QUEUE_SIZE=100

# AI Configuration
AI_ENABLED=false
AI_DEFAULT_MODE=hybrid
AI_CONFIDENCE_THRESHOLD=0.7
AI_MAX_RESPONSE_TIME=30000

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_BATCH_SIZE=100

# Health Monitoring
HEALTH_CHECK_INTERVAL=30000
HEALTH_DB_TIMEOUT=5000
HEALTH_CACHE_TIMEOUT=2000
HEALTH_WHATSAPP_TIMEOUT=10000

# Puppeteer Configuration (for WhatsApp Web)
PUPPETEER_ARGS=["--no-sandbox","--disable-setuid-sandbox","--disable-dev-shm-usage","--disable-accelerated-2d-canvas","--no-first-run","--no-zygote","--disable-gpu"]